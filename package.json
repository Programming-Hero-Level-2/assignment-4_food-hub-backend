{
  "name": "food-hub-backend",
  "version": "1.0.0",
  "description": "This is the backend for the Food Hub application, which provides APIs for managing food ordering services. It is built using Node.js and Express, and it connects to a postgres database to store information.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:generate": "prisma generate -schema=./prisma/schema/",
    "db:push": "prisma db push -schema=./prisma/schema/",
    "db:pull": "prisma db pull -schema=./prisma/schema/",
    "db:studio": "prisma studio -schema=./prisma/schema/"
  },
  "keywords": [
    "food hub",
    "backend",
    "node.js",
    "express",
    "postgres",
    "api"
  ],
  "author": "Naiemul Islam",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.16.0",
    "morgan": "^1.10.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "schema": "./prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@types/cors": "^2.8.19",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "better-auth": "^1.4.18",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "multer": "^2.0.2",
    "pg": "^8.18.0",
    "prisma": "^7.4.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "yamljs": "^0.3.0",
    "zod": "^4.3.6"
  }
}
